# Luxe — Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# Get these values from https://app.supabase.com → Project Settings → API

SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: Set to 'true' to force mock mode (ignores Supabase, uses localStorage)
# Useful for development without a Supabase project
LUXE_MOCK_MODE=false
